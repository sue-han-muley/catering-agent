# Copy to secrets.toml and fill in — never commit secrets.toml
# On Streamlit Cloud, paste these as-is into App Settings > Secrets

APP_PASSWORD  = "pick-a-strong-password"

TOKEN_URL     = "https://your-idp.example.com/oauth2/token"
CLIENT_ID     = "your-client-id"
CLIENT_SECRET = "your-client-secret"

